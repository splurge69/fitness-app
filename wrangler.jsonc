{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-app",
  // George's personal Cloudflare account
  "account_id": "01a2fe9a8d18aac6a9765bed0bccf954",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-app",
      "database_id": "d788bd1c-7ef7-49c8-91c0-59b5032b91ea",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
